# ─────────────────────────────────────────────────────────────────────────────
#  Energy IQ backend — environment template
#
#  Copy to `.env` beside this file and fill in real values:
#      cp backend/.env.example backend/.env && chmod 600 backend/.env
#
#  `.env` is git-ignored and must stay that way. It is read by
#  `app/main.py` via python-dotenv at import time, so the backend must be
#  started with `backend/` as the working directory.
#
#  Nothing here has a safe default. A missing key disables the feature that
#  needs it rather than failing the process — see docs/Security.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Large language model (AI Center narrative summaries) ─────────────────────
# Set to 0 to disable every LLM call. The statistical models
# (forecasting, anomaly detection, clustering) are unaffected — they are
# scikit-learn and run locally.
LLM_ENABLED=1

# Google Gemini. Obtain a key at https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# ── Monitoring notifications ─────────────────────────────────────────────────
# Telegram delivery for the alerting subsystem. Deliberately kept here rather
# than in monitoring_config.json so credentials are never captured by a config
# backup or a support tarball.
#
# Bot token: talk to @BotFather. Chat id: add the bot to the target chat and
# read `result[0].message.chat.id` from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Leaving either blank disables delivery; alerts are still recorded and the
# outbox retains them.
MONITORING_TELEGRAM_BOT_TOKEN=
MONITORING_TELEGRAM_CHAT_ID=
