#!/usr/bin/env python3
"""Recovery framework CLI.

  status      show every module, its flag, and what it can/cannot recover
  arm-ups     arm the UPS wake register  (shutdown hook only; no-op if disabled)
  rtc-set     set the rolling RTC alarm  (no-op if disabled)
  rtc-clear   clear the RTC alarm
  self-heal   run one collector stall check (no-op if disabled)
"""
import sys
sys.path.insert(0, "/opt/energy-node/hardening/lib")
import recovery
from recovery import ups_wake, rtc_wake, selfheal

CMDS = {
    "status":    recovery.print_status,
    "arm-ups":   ups_wake.arm,
    "rtc-set":   rtc_wake.set_alarm,
    "rtc-clear": rtc_wake.clear,
    "self-heal": selfheal.run,
}
cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
if cmd not in CMDS:
    print(__doc__)
    sys.exit(2)
sys.exit(CMDS[cmd]())
